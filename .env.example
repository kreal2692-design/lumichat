# LumiMatch Server Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=https://aaszyppzidhazpbmcipv.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Server Configuration
PORT=3000
NODE_ENV=production

# Security
ADMIN_SECRET=lumiadmin2025
SYSTEM_USER_ID=system-user-uuid-here

# Rate Limiting (adjust as needed)
RATE_LIMIT=100
MAX_CONNECTIONS_PER_IP=5
MSG_LIMIT=20

# CORS (for production)
CORS_ORIGIN=https://lumimatch.net

# Database (optional - for future use)
DATABASE_URL=postgresql://user:password@localhost:5432/lumimatch