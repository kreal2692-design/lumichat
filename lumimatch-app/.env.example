SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# IYZICO PAYMENT CONFIG (Turkey)
# ============================================
# Test Environment
IYZICO_API_KEY=sandbox-your-api-key
IYZICO_SECRET_KEY=sandbox-your-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Production Environment (uncomment when ready)
# IYZICO_API_KEY=your-live-api-key
# IYZICO_SECRET_KEY=your-live-secret-key
# IYZICO_BASE_URL=https://api.iyzipay.com

# ============================================
# AGORA WEBRTC CONFIG
# ============================================
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_CUSTOMER_ID=your-customer-id
AGORA_CUSTOMER_SECRET=your-customer-secret

# ============================================
# EXPO CONFIG
# ============================================
EXPO_PUBLIC_API_URL=https://api.lumimatch.app
EXPO_PUBLIC_APP_ENV=development

# Production values (uncomment when deploying)
# EXPO_PUBLIC_APP_ENV=production

# ============================================
# APP CONFIG
# ============================================
APP_NAME=LumiMatch
APP_VERSION=2.5.0
APP_BUILD=25

# ============================================
# PUSH NOTIFICATIONS
# ============================================
EXPO_PUSH_TOKEN=your-expo-push-token
FCM_SERVER_KEY=your-firebase-server-key

# ============================================
# ANALYTICS
# ============================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your-mixpanel-token

# ============================================
# STORAGE
# ============================================
AWS_S3_BUCKET=lumimatch-media
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15

# ============================================
# CONTENT MODERATION
# ============================================
OPENAI_API_KEY=your-openai-api-key
CLARIFAI_API_KEY=your-clarifai-api-key

# ============================================
# EMAIL SERVICE
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# ============================================
# SMS SERVICE
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# MONITORING
# ============================================
SENTRY_DSN=your-sentry-dsn
SENTRY_ENV=development

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_VIDEO_CALLS=true
ENABLE_LIVE_STREAMS=true
ENABLE_PAYMENTS=true
ENABLE_AI_MODERATION=false
ENABLE_ANALYTICS=true
